/* English permission purpose strings. Mirrors the NS*UsageDescription values
   in Info.plist; keep both in sync (test/i18n/platform_locales_test.dart). */

/* Shown when DitMesh first asks for the camera (scanning a Tox ID QR code). */
"NSCameraUsageDescription" = "DitMesh uses the camera only to scan a friend's Tox ID QR code.";

