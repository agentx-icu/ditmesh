# ditmesh: macOS 10.15 is the runtime floor (tim2tox_ffi is built with
# -mmacosx-version-min=10.15; matches MACOSX_DEPLOYMENT_TARGET in Runner.xcodeproj).
platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))

  # ditmesh: bundle libtim2tox_ffi
  # The Tox backend is vendored as Frameworks/libtim2tox_ffi.dylib (staged by
  # tool/ci/build_tim2tox.sh --target macos; gitignored). CocoaPods links Runner
  # against it and embeds it into DitMesh.app/Contents/Frameworks/, which
  # Tim2Tox's Dart loader probes (<exe dir>/../Frameworks/libtim2tox_ffi.dylib).
  # The dylib's install name is @rpath/libtim2tox_ffi.dylib and Runner's
  # LD_RUNPATH_SEARCH_PATHS contains @executable_path/../Frameworks, so the
  # link-time reference resolves inside the bundle. Declared only when the
  # artifact exists. UI tests may set DITMESH_ALLOW_MISSING_FFI=1 explicitly.
  tim2tox_dylib = File.join(__dir__, 'Frameworks', 'libtim2tox_ffi.dylib')
  if File.file?(tim2tox_dylib)
    pod 'Tim2ToxFFI', :path => 'Frameworks'
  elsif ENV['DITMESH_ALLOW_MISSING_FFI'] == '1'
    Pod::UI.warn "ditmesh: #{tim2tox_dylib} not found — the macOS app will have NO Tox backend. Run tool/ci/build_tim2tox.sh --target macos first."
  else
    raise 'DitMesh requires libtim2tox_ffi.dylib. Run tool/ci/build_tim2tox.sh --target macos before building.'
  end

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
end
