<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ per-app language list (Settings > System > Languages > App
     languages), referenced by android:localeConfig in AndroidManifest.xml.

     Hand-written on purpose, NOT generated by AGP's generateLocaleConfig: that
     derives the list from Android res/ and dependency resources, not from the
     Flutter ARB files, and can advertise languages the app has no strings for.
     This list must equal the ARB set in lib/l10n/app_*.arb (zh -> zh-Hans,
     zh_Hant -> zh-Hant, others as-is with '_' -> '-'), in the same order as
     the iOS/macOS CFBundleLocalizations; the drift test
     test/i18n/platform_locales_test.dart enforces the set.

     Precedence: an explicit choice in the in-app language picker wins. When the
     in-app choice is "System default" the app follows the OS locale, which on
     Android 13+ already includes the per-app language picked here. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en"/>
    <locale android:name="zh-Hans"/>
    <locale android:name="zh-Hant"/>
    <locale android:name="ja"/>
    <locale android:name="ko"/>
    <locale android:name="de"/>
    <locale android:name="fr"/>
    <locale android:name="es"/>
    <locale android:name="pt"/>
    <locale android:name="ru"/>
</locale-config>
