<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup policy for DitMesh: nothing leaves the device
  through Google cloud backup or device-to-device transfer. The Tox profile
  (private key), chat history and settings live in the app's files dir;
  the encrypted in-app .mcqbackup export is the only supported way to move an
  identity. See the comment on <application> in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
        <exclude domain="device_root"/>
        <exclude domain="device_file"/>
        <exclude domain="device_database"/>
        <exclude domain="device_sharedpref"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
        <exclude domain="device_root"/>
        <exclude domain="device_file"/>
        <exclude domain="device_database"/>
        <exclude domain="device_sharedpref"/>
    </device-transfer>
</data-extraction-rules>
