# Uncomment this line to define a global platform for your project
# ditmesh: iOS 14.0 is the runtime floor (tim2tox_ffi is built with
# -miphoneos-version-min=14.0; see doc/operations/BUILD_AND_DEPLOY.md).
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ditmesh: bundle libtim2tox_ffi
  # The Tox backend is vendored as Frameworks/tim2tox_ffi.xcframework (device +
  # simulator slices), produced by tool/build_ios_ffi.sh and gitignored. CocoaPods
  # embeds the matching slice into Runner.app/Frameworks/tim2tox_ffi.framework,
  # which is where Tim2Tox's Dart loader looks. Declared only when the artifact
  # exists. UI tests may explicitly set DITMESH_ALLOW_MISSING_FFI=1; ordinary
  # builds fail early instead of shipping an unusable chat application.
  tim2tox_xcframework = File.join(__dir__, 'Frameworks', 'tim2tox_ffi.xcframework')
  if File.directory?(tim2tox_xcframework)
    pod 'Tim2ToxFFI', :path => 'Frameworks'
  elsif ENV['DITMESH_ALLOW_MISSING_FFI'] == '1'
    Pod::UI.warn "ditmesh: #{tim2tox_xcframework} not found — the iOS app will have NO Tox backend. Run tool/build_ios_ffi.sh first."
  else
    raise 'DitMesh requires tim2tox_ffi.xcframework. Run tool/build_ios_ffi.sh before building.'
  end

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
