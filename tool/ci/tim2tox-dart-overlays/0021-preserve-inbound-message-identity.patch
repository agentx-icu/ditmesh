+int _callbackSources(ChatMessage row) {
+  var sources = 0;
+  for (final id in [row.msgID, ...row.altMsgIds]) {
+    if (isNativeCallbackMessageId(id)) sources |= 1;
+    if (id != null && _pollCallbackId.hasMatch(id)) sources |= 2;
+  }
+  return sources;
