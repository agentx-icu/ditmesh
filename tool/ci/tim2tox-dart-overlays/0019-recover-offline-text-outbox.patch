+  Future<void> _restoreQueueOnlyTextRows(
+    Map<String, List<OfflineMessageItem>> queue,
+  ) async {
+    final epoch = _sessionEpoch;
+    for (final entry in queue.entries) {
+      final isGroup = entry.key.startsWith('group:');
+      final key = isGroup ? entry.key.substring('group:'.length) : entry.key;
