+      final matchedLegacyRows = Set<ChatMessage>.identity();
+      final occupied = {
+        for (final item in entry.value)
+          if (item.msgID != null && item.msgID!.isNotEmpty) item.msgID!,
+      };
+      var restored = false;
+      for (final item in entry.value) {
+        if (!current()) break;
+        if (item.kind != 'text' ||
+            item.text.isEmpty ||
+            (item.filePath?.isNotEmpty ?? false) ||
+            !OfflineSendControl.dispatchable(item.control)) {
+          continue;
+        }
+        var id = item.msgID;
+        final legacy = id == null || id.isEmpty;
+        ChatMessage? match(List<ChatMessage> rows) {
+          if (!legacy) {
+            final at = _ownRowIndex(rows, id!);
+            return at < 0 ? null : rows[at];
+          }
+          final at = rows.lastIndexWhere(
+            (row) =>
+                !matchedLegacyRows.contains(row) &&
+                !occupied.contains(row.msgID) &&
+                _tombstoneRowIndex([row], item) == 0,
+          );
+          return at < 0 ? null : rows[at];
+        }
