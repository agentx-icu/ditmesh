+        var existing = match(hot);
+        if (existing == null) {
+          try {
+            archived ??= await _messageHistoryPersistence.loadArchivedHistory(
+              key,
+              throwOnReadFailure: true,
+            );
+          } catch (_) {
+            // Without a readable archive we cannot tell whether the row
+            // already exists. Keep the queue and retry recovery next boot.
+            break;
+          }
+          if (!current()) break;
+          existing = match(archived);
+        }
+        if (legacy) {
+          if (existing != null) {
+            matchedLegacyRows.add(existing);
+            if (existing.msgID == null || existing.msgID!.isEmpty) continue;
+          }
+          id =
+              existing?.msgID ??
+              'queued:${DateTime.now().microsecondsSinceEpoch}:${_msgIDSequence++}:$_selfId';
+          // Persist the ID first. Another interruption repeats the same
+          // recovery, and the reconstructed row can be cancelled by ID.
+          try {
+            if (!await _offlineQueuePersistence.replaceItem(entry.key, item, (
+              kind: item.kind,
+              text: item.text,
+              filePath: item.filePath,
+              fileName: item.fileName,
+              timestamp: item.timestamp,
+              msgID: id,
+              cloudCustomData: item.cloudCustomData,
+              contentKind: item.contentKind,
+              control: item.control,
+            )))
+              continue;
+          } catch (error, stack) {
+            _logger?.logError(
+              '[FfiChatService] could not recover queued ID',
+              error,
+              stack,
+            );
+            continue;
+          }
+          occupied.add(id);
+        }
+        if (!current()) break;
+        if (existing != null) continue;
+        final row = _queuedTextRow(item, id!, group: isGroup ? key : null);
+        _messageHistoryPersistence.appendHistory(key, row).ignore();
+        _rememberRecoveredPreview(key, row);
+        restored = true;
+      }
+      // Persist any recovered rows without waiting for the debounce. A
+      // failed history write is retried by persistence and leaves the
+      // authoritative queue intact for a later restart.
+      if (restored && current()) await _saveHistory(key);
+    }
+  }
+
+  void _rememberRecoveredPreview(String key, ChatMessage row) {
+    final last = _lastByPeer[key];
+    if (last == null || !row.timestamp.isBefore(last.timestamp)) {
+      _lastByPeer[key] = row;
+    }
+  }
+
+  ChatMessage _queuedTextRow(
+    OfflineMessageItem item,
+    String id, {
+    String? group,
+    String? alias,
+    bool pending = true,
+  }) {
+    return ChatMessage(
+      text: item.text,
+      fromUserId: _selfId,
+      isSelf: true,
+      timestamp: item.timestamp,
+      groupId: group,
+      isPending: pending,
+      msgID: id,
+      cloudCustomData: item.cloudCustomData,
+      contentKind: item.contentKind,
+      altMsgIds: [if (alias != null) alias],
+    );
   }

