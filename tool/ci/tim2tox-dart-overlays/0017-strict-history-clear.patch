+  Future<void> _recoverStrictClear(File primary) async {
+    final pending = Directory('${primary.path}$_clearPendingSuffix');
+    if (await pending.exists()) await _restoreStrictClear(primary, pending);
+    final discarded = Directory('${primary.path}$_clearDiscardedSuffix');
+    if (await discarded.exists()) await _removeStrictClearStage(discarded);
+  }
