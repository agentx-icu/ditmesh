+      if (entity is! Directory) continue;
+      final name = p.basename(entity.path);
+      for (final suffix in [_clearPendingSuffix, _clearDiscardedSuffix]) {
+        if (!name.endsWith('.json$suffix')) continue;
+        ids.add(name.substring(0, name.length - suffix.length - 5));
+      }
