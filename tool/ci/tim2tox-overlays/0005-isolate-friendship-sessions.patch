@@ -0,0 +1,54 @@
+// Exercise the real default SDK manager reused by identity replacement.
+#include <cstdlib>
+#include <iostream>
+
+#include "V2TIMFriendshipManagerImpl.h"
+#include "V2TIMManager.h"
+#include "tim2tox_ffi.h"
+
+struct ReadApplications final : V2TIMValueCallback<V2TIMFriendApplicationResult> {
+    size_t size = 0;
+    void OnSuccess(const V2TIMFriendApplicationResult& result) override {
+        size = result.applicationList.Size();
+    }
+    void OnError(int, const V2TIMString&) override { std::abort(); }
+};
+
+struct ApplicationsListener final : V2TIMFriendshipListener {
+    int calls = 0;
+    void OnFriendApplicationListAdded(const V2TIMFriendApplicationVector&) override {
+        ++calls;
+    }
+};
+
+int main(int argc, char** argv) {
+    if (argc != 3) return 2;
+    if (tim2tox_ffi_init_with_path(argv[1]) != 1) return 3;
+    auto* friendship = static_cast<V2TIMFriendshipManagerImpl*>(
+        V2TIMManager::GetInstance()->GetFriendshipManager());
+    ApplicationsListener listener;
+    friendship->AddFriendListener(&listener);
+    V2TIMFriendApplication application;
+    application.userID = "2222222222222222222222222222222222222222222222222222222222222222";
+    application.addWording = "account A private request";
+    V2TIMFriendApplicationVector applications;
+    applications.PushBack(application);
+    friendship->NotifyFriendApplicationListAdded(applications);
+    ReadApplications before;
+    friendship->GetFriendApplicationList(&before);
+    tim2tox_ffi_uninit();
+
+    if (tim2tox_ffi_init_with_path(argv[2]) != 1) return 4;
+    auto* next = static_cast<V2TIMFriendshipManagerImpl*>(
+        V2TIMManager::GetInstance()->GetFriendshipManager());
+    ReadApplications after;
+    next->GetFriendApplicationList(&after);
+    // Session cleanup must preserve the Dart listener registration.
+    next->NotifyFriendApplicationListAdded(applications);
+    next->RemoveFriendListener(&listener);
+    std::cout << "Account A pending=" << before.size
+              << "; account B pending=" << after.size
+              << "; listener calls=" << listener.calls << std::endl;
+    tim2tox_ffi_uninit();
+    return before.size == 1 && after.size == 0 && listener.calls == 2 ? 0 : 1;
+}
